# DrinkLeague — copy to .env.local and fill with your Supabase project keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Production (Netlify): set this to your live URL, e.g. https://drinkleague.netlify.app
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (PWA) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@drinkleague.app

# --- Netlify Site settings (Site configuration → Environment variables) ---
# Required for login on Netlify (same values as .env.local, but APP_URL = your Netlify URL):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_APP_URL=https://YOUR-SITE.netlify.app
#   NEXT_PUBLIC_VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY
#   VAPID_SUBJECT
#
# Also in Supabase Dashboard → Authentication → URL Configuration:
#   Site URL = https://YOUR-SITE.netlify.app
#   Redirect URLs += https://YOUR-SITE.netlify.app/**
